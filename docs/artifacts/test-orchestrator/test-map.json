  "unityVisibleRoots": ["Assets/**", "Packages/**", "ProjectSettings/**"],

  "infrastructure": [
    {"pattern": "docs/artifacts/editor-memory/**", "reason": "safe_unity_test.sh and its guarded loop / sampler",
     "staticChecks": ["bash docs/artifacts/editor-memory/selftest_parser.sh", "bash docs/artifacts/editor-memory/selftest_loop.sh", "bash docs/artifacts/editor-memory/selftest_safe_entry.sh", "powershell -NoProfile -File docs/artifacts/editor-memory/selftest_watch.ps1"]},
    {"pattern": "docs/artifacts/test-orchestrator/**", "reason": "this selector, its rules and the known-failure list",
     "staticChecks": ["python -I docs/artifacts/test-orchestrator/selftest.py"]}
  ],
  "skillMirrorRoots": [".claude/skills/**", ".agents/skills/**"],

  "highRisk": [
    {"pattern": "ProjectSettings/**", "rule": "E6", "reason": "project settings (physics layers, time, input, Unity version)"},
    {"pattern": "Packages/**", "rule": "E6", "reason": "package manifest / lock"},
    {"pattern": "**/*.asmdef", "rule": "E6", "reason": "assembly definition (compile graph)"},
    {"pattern": "**/*.asmref", "rule": "E6", "reason": "assembly reference"},
    {"pattern": "Assets/_Project/Tests/EditMode/ArchitectureRegressionTests.cs", "rule": "E5", "reason": "architecture invariants (WriterRules / LayerRules)"},
    {"pattern": "Assets/_Project/Tests/EditMode/PrefabWiringTests.cs", "rule": "E5", "reason": "prefab wiring contracts"},
    {"pattern": "Assets/Scenes/**", "rule": "E7", "reason": "shipped scene (9 PlayMode fixtures load it)"},
    {"pattern": "Assets/Prefabs/**", "rule": "E7", "reason": "character / projectile prefabs"},
    {"pattern": "Assets/ScriptableObjects/**", "rule": "E7", "reason": "state machine configs, motion bake data, audio banks"},
    {"pattern": "Assets/**/*.inputactions", "rule": "E7", "reason": "input bindings"},
    {"pattern": "Assets/Scripts/Core/Blackboard/**", "rule": "E3", "reason": "blackboard schema"},
    {"pattern": "re:^Assets/Scripts/(Core|Presentation)/(.+/)?I[A-Z][A-Za-z0-9]*\\.cs$", "rule": "E3", "reason": "cross-layer interface (core driving interfaces, sinks, sources)"},
    {"pattern": "Assets/Scripts/Presentation/Animation/**", "rule": "E3", "reason": "AnimationFacadeBase / AnimancerFacade boundary"},
    {"pattern": "Assets/Scripts/Core/StateMachine/BaseState.cs", "rule": "E3", "reason": "FSM base"},
    {"pattern": "Assets/Scripts/Core/StateMachine/FullBodyStateMachine.cs", "rule": "E3", "reason": "FSM topology"},
    {"pattern": "Assets/Scripts/Core/StateMachine/StateMachineConfigSO.cs", "rule": "E3", "reason": "FSM config schema"},
    {"pattern": "Assets/Scripts/Core/StateMachine/StateParamsSO.cs", "rule": "E3", "reason": "state params base"},
    {"pattern": "Assets/Scripts/Core/StateMachine/StateRule.cs", "rule": "E3", "reason": "FSM transition rules"},
    {"pattern": "Assets/Scripts/Core/StateMachine/StateType.cs", "rule": "E3", "reason": "FSM state enum (serialized as int)"},
    {"pattern": "Assets/Scripts/Core/StateMachine/States/IdleState.cs", "rule": "E3", "reason": "every character's base locomotion state"},
    {"pattern": "Assets/Scripts/Core/StateMachine/States/MoveState.cs", "rule": "E3", "reason": "every character's base locomotion state"},
    {"pattern": "Assets/Scripts/Core/StateMachine/States/RollState.cs", "rule": "E3", "reason": "no targeted PlayMode fixture is known: unknown impact"},
    {"pattern": "Assets/Scripts/Core/Facing/**", "rule": "E3", "reason": "facing authority (A31/A32)"},
    {"pattern": "Assets/Scripts/Core/Arbitration/ArbiterData.cs", "rule": "E3", "reason": "arbitration flags (blackboard data)"},
    {"pattern": "Assets/Scripts/Presentation/Motion/MotionBakeData.cs", "rule": "E3", "reason": "motion truth for every state"}
  ],

