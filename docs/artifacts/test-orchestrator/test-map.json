{
  "schema": 1,
  "_comment": "docs/57 §5, §12. Selector rules. Patterns are globs (** crosses '/', * does not) or 're:<regex>'. Changing this file invalidates the snapshot (mapHash) and is itself an R3 change.",

  "costModel": {
    "invocationOverheadSeconds": 60,
    "editModeSeconds": 6,
    "_source": "Logs/safe-test 2026-10-12..13: EditMode full 956 tests 5.4 s runner time, 66-79 s wall; single-class PlayMode 59-94 s wall"
  },
  "snapshotMaxAgeDays": 7,
  "playModeNamespace": "Project.Tests.PlayMode.",
  "writerRulesSource": "Assets/_Project/Tests/EditMode/ArchitectureRegressionTests.cs",
  "smokeFixtures": ["AICombatContextPlayModeTests"],
