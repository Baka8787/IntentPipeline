  "_editorComment": "docs/57 §12.4. class: readOnly -> R1; writerScoped -> R2 with the fixtures that consume its products; writerUniversal -> R3. Source markers are a consistency check: a file declared readOnly that contains a write marker, or any file with an auto-run marker, is R3.",
  "editorAutoRunMarkers": ["InitializeOnLoad", "DidReloadScripts", "AssetPostprocessor", "AssetModificationProcessor"],
  "editorWriteMarkers": ["AssetDatabase.Create", "AssetDatabase.Save", "AssetDatabase.Import", "AssetDatabase.Delete", "AssetDatabase.Move", "AssetDatabase.Copy", "EditorUtility.SetDirty", "ApplyModifiedProperties", "PrefabUtility.Save", "PrefabUtility.Apply", "SaveAndReimport", "ModelImporter", "Undo.", "EditorSceneManager.MarkSceneDirty", "EditorSceneManager.SaveScene"],
